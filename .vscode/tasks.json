{
  // VS Code tasks: MySQL, the backend and the frontend start AUTOMATICALLY
  // every time this project folder is opened in VS Code ("runOn": "folderOpen").
  // Each one gets its own terminal tab. Close a tab (bin icon) to stop that part.
  // Run them by hand: Ctrl+Shift+P > "Tasks: Run Task" > pick one.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "MySQL",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}\\scripts\\mysql-if-needed.ps1"],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "reveal": "silent" },
      "runOptions": { "runOn": "folderOpen" }
    },
    {
      "label": "Backend (Flask)",
      "type": "process",
      "command": "${workspaceFolder}\\backend\\venv\\Scripts\\flask.exe",
      "args": ["run", "--port", "5000"],
      "options": { "cwd": "${workspaceFolder}\\backend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "reveal": "silent" },
      "runOptions": { "runOn": "folderOpen" }
    },
    {
      "label": "Frontend (React)",
      "type": "process",
      "command": "npm.cmd",
      "args": ["run", "dev"],
      "options": { "cwd": "${workspaceFolder}\\frontend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "reveal": "silent" },
      "runOptions": { "runOn": "folderOpen" }
    }
  ]
}
