# Copy this file to .env and fill in real values. Never commit .env.

# --- MySQL / MariaDB connection (XAMPP defaults: root with an empty password) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=wbl_placement
# Separate database used only by pytest (it is wiped between tests)
TEST_DB_NAME=wbl_placement_test

# --- Security ---
# Use a long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
# Access token lifetime in minutes
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

# Password of the default admin created by `flask seed-data` (username "Admin").
# Defaults to "Admin" for local demos. Set a strong value before going live.
DEFAULT_ADMIN_PASSWORD=Admin

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Flask CLI ---
FLASK_APP=wsgi.py
FLASK_DEBUG=1
